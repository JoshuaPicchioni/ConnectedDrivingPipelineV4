#!/usr/bin/env python3
"""
Pipeline Queue Web Dashboard Generator
Generates an HTML status page at /var/www/static/pipeline-status.html
"""

import json
import os
import subprocess
from datetime import datetime
from pathlib import Path

QUEUE_DIR = Path.home() / ".pipeline-queue"
QUEUE_FILE = QUEUE_DIR / "queue.json"
STATE_FILE = QUEUE_DIR / "state.json"
PID_FILE = QUEUE_DIR / "daemon.pid"
OUTPUT_FILE = Path("/var/www/static/pipeline-status.html")
RESULTS_BASE = Path("/var/www/static/pipeline-results")

def load_queue():
    try:
        return json.loads(QUEUE_FILE.read_text())
    except:
        return []

def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except:
        return {"current_job": None, "history": []}

def get_progress_from_log(log_path):
    if not Path(log_path).exists():
        return None
    
    try:
        result = subprocess.run(
            ["tail", "-100", str(log_path)],
            capture_output=True, text=True
        )
        lines = result.stdout.strip().split('\n')
        
        progress = {
            "stage": "Unknown",
            "last_activity": None,
            "rows_processed": 0,
        }
        
        for line in reversed(lines):
            if "DataGatherer:" in line and "line" in line:
                try:
                    parts = line.split("line ")
                    if len(parts) > 1:
                        progress["rows_processed"] = int(parts[1].strip())
                        progress["stage"] = "Data Gathering"
                except:
                    pass
            elif "ConnectedDrivingLargeDataCleaner:" in line:
                progress["stage"] = "Data Cleaning"
            elif "Training" in line or "Fitting" in line or "TRAINING" in line:
                progress["stage"] = "Model Training"
            elif "Evaluating" in line or "Testing" in line:
                progress["stage"] = "Evaluation"
            elif "COMPLETE" in line:
                progress["stage"] = "Complete"
            
            if progress["last_activity"] is None and "LogLevel" in line:
                try:
                    ts = line.split("LogLevel.INFO ")[1].split(" ")[0:2]
                    progress["last_activity"] = " ".join(ts)
                except:
                    pass
        
        return progress
    except:
        return None

def format_duration(seconds):
    if seconds < 60:
        return f"{seconds:.0f}s"
    elif seconds < 3600:
        return f"{int(seconds // 60)}m {int(seconds % 60)}s"
    else:
        hours = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        return f"{hours}h {mins}m"

def is_daemon_running():
    if not PID_FILE.exists():
        return False
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except:
        return False

def generate_html():
    state = load_state()
    queue = load_queue()
    current = state.get("current_job")
    history = state.get("history", [])
    daemon_running = is_daemon_running()
    
    # Get progress for current job
    progress = None
    runtime = None
    if current and current.get("results_dir"):
        log_path = Path(current["results_dir"]) / "pipeline.log"
        progress = get_progress_from_log(log_path)
        if current.get('started_at'):
            try:
                start = datetime.strptime(current['started_at'], "%Y-%m-%d %H:%M:%S")
                runtime = format_duration((datetime.now() - start).total_seconds())
            except:
                pass
    
    html = f'''<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content="30">
    <title>Pipeline Queue Status</title>
    <style>
        * {{ box-sizing: border-box; margin: 0; padding: 0; }}
        body {{ 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            color: #eee;
            padding: 20px;
        }}
        .container {{ max-width: 1200px; margin: 0 auto; }}
        h1 {{ 
            text-align: center; 
            margin-bottom: 30px; 
            font-size: 2.5em;
